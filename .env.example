# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored so secrets never get committed.

# Public URL Ghost is served on.
#   Local testing:        http://localhost
#   Production (IP only): http://203.0.113.10
#   Production (domain):  https://blog.example.com (must match CADDY_SITE_ADDRESS)
GHOST_URL=http://localhost

# Caddy site address. Leave unset (defaults to ":80", plain HTTP) for local
# testing or an IP-only production server. Once you have a domain, set it
# (no scheme), e.g. blog.example.com — Caddy then serves HTTPS with an
# automatic Let's Encrypt certificate.
#CADDY_SITE_ADDRESS=blog.example.com

# MySQL credentials — CHANGE THESE before any real deployment.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me-ghost-password

# --- Web analytics (Tinybird Local, self-hosted) ------------------------------
# Hard memory cap of the tinybird-local container (ClickHouse + Redis + API).
# It idles around 1-1.5 GB; keep >= 2g. Raise on a bigger box.
TINYBIRD_MEMORY_LIMIT=3g
# traffic-analytics verbosity (debug is chatty: one line per page hit).
#TRAFFIC_ANALYTICS_LOG_LEVEL=info
#
# The three TINYBIRD_* values below are generated — do NOT fill them in by hand:
# `make analytics-init` (also run by `make dev` / `make prod`) deploys Ghost's
# Tinybird project into tinybird-local, then appends them here:
#   TINYBIRD_WORKSPACE_ID   workspace Ghost puts in the JWTs it signs
#   TINYBIRD_ADMIN_TOKEN    workspace admin token — signs those JWTs (server side only)
#   TINYBIRD_TRACKER_TOKEN  APPEND-only token traffic-analytics uses to ingest page hits

# --- Facebook auto-share (social-publisher) -----------------------------------
# Every published post goes out on your Facebook Page (title + excerpt + link).
# Full setup (Meta app, Page token, Ghost webhook): docs/social-facebook.md
#
# Secret shared by Ghost's webhook and the publisher. Generate one with
# `openssl rand -hex 32` (scripts/social-deploy-prod.sh does it for you on the server).
#SOCIAL_WEBHOOK_SECRET=
# Meta app id (developers.facebook.com → the app → App settings → Basic). Not a
# secret, only a prompt default for `make facebook-token`.
#FACEBOOK_APP_ID=
# The Facebook PAGE (a profile, even in "professional mode", cannot be used) and
# its Page access token — `make facebook-token` prints both from a short-lived
# user token. Page tokens derived from a long-lived user token never expire.
#FACEBOOK_PAGE_ID=
#FACEBOOK_PAGE_ACCESS_TOKEN=
# Log what would be posted without calling Facebook (local testing).
#FACEBOOK_DRY_RUN=1
# Graph API version; bump before Meta retires it
# (https://developers.facebook.com/docs/graph-api/changelog/versions/).
#FACEBOOK_GRAPH_VERSION=v26.0
# Internal tag that keeps a post off Facebook: tag it "#no-facebook" in Ghost.
#SOCIAL_SKIP_TAG=hash-no-facebook
# Internal tag that shares an already-published post when you save it: "#facebook".
#SOCIAL_SHARE_TAG=hash-facebook
