# Team console config — copy to console.env on the server (git-ignored).
# SMTP_* and MAIL_FROM are injected by compose from the main .env.
GHOST_ADMIN_URL=https://landes-insoumises.fr
# Ghost custom integration Admin API key (same one DoG uses is fine).
GHOST_ADMIN_TOKEN=<id:secret>
# The hidden "Équipe" tier that grants forum access (see docs/forum-discourse.md).
EQUIPE_TIER_ID=<24-hex tier id>
CONSOLE_PUBLIC_URL=https://landes-insoumises.fr
SITE_NAME=Dax insoumise
FORUM_URL=https://forum.landes-insoumises.fr
INVITE_TTL_DAYS=7
